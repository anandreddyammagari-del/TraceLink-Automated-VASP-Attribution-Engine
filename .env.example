# TraceLink Workstation Configuration
# Cyber Crime & Law Enforcement Units Environment Variables

# Operational Mode
OFFLINE_MODE=true
APP_ENV=development
LOG_LEVEL=INFO

# Cyber Officer Authentication & Security
SECRET_KEY=tracelink_super_secret_forensic_jwt_signing_key_94bnss_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
WORKSTATION_ID=CYBER-UNIT-DELHI-01

# Primary Database (PostgreSQL with SQLite local offline fallback)
DATABASE_URL=sqlite+aiosqlite:///./tracelink_offline.db
POSTGRES_USER=tracelink_admin
POSTGRES_PASSWORD=police_secure_pass_2026
POSTGRES_DB=tracelink_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Cache (in-memory fallback when offline/unreachable)
REDIS_URL=redis://localhost:6379/0

# Kafka Broker (in-memory queue fallback when offline/unreachable)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TRACE_TOPIC=tracelink-traces-v1

# Neo4j Graph Database (for cross-case intelligence)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=police_graph_secure_2026

# External API Integrations (Optional in Offline Mode)
COVALENT_API_KEY=cqt_demo_key_placeholder
CHAINALYSIS_API_KEY=chainalysis_demo_key_placeholder
ETHERSCAN_API_KEY=etherscan_demo_key_placeholder

# Legal Notice & Seizure Settings
DEFAULT_POLICE_STATION=Special Cyber Cell, State Crime Branch
JURISDICTION=State Cyber Operations Division
MANDATORY_LEGAL_CAVEAT="Investigative draft generated locally for officer review. Direct electronic submission to external portals is deactivated."
